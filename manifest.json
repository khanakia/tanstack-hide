{
  "manifest_version": 3,
  "name": "TanStack Devtools Trigger Hide",
  "version": "1.3.0",
  "description": "Hides the floating TanStack Devtools corner button, globally or per site. The panel still opens with its hotkey.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TanStack Devtools Trigger Hide",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Toggle hiding on the current site"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "hide.css"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
